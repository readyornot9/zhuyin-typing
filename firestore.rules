rules_version = '2';
// 排行榜規則：任何人都能看；只能新增、不能改或刪；欄位和數值範圍都要合理
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'speed', 'acc', 'at'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.speed is int && d.speed >= 1 && d.speed <= 200
        && (d.acc is int || d.acc is float) && d.acc >= 0 && d.acc <= 100
        && d.at == request.time;
    }
    match /daily/{day}/scores/{id} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validScore();
    }
    match /minute/{id} {
      allow read: if true;
      allow create: if validScore();
    }
  }
}
